[Desktop Entry]
Type=Application
Name=Grok Bot X
Name[zh_CN]=Grok Bot X（增强）
Comment=Start Grok Bot with grokbot-x add-ons (EditHere image editing)
Comment[zh_CN]=启动 Grok Bot 并加载 grokbot-x 增强功能（EditHere 图片编辑）
Exec=/opt/grokbot-x/bin/grokbot-x
Icon=grokbot-x
Terminal=false
Categories=Utility;
StartupNotify=false
Actions=stop;

[Desktop Action stop]
Name=Stop grokbot-x add-ons
Name[zh_CN]=停止 grokbot-x 增强
Exec=/opt/grokbot-x/bin/grokbot-x-stop
