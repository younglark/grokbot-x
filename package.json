{
  "name": "grokbot-x",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Unofficial Electron add-on for the Grok Bot desktop client (CDP, loopback only)",
  "license": "MIT",
  "author": "grokbot-x",
  "main": "electron/main.mjs",
  "scripts": {
    "build:editor": "node features/edithere/editor/build.mjs",
    "start": "node features/edithere/editor/build.mjs && electron .",
    "test": "node features/edithere/editor/build.mjs && node --test tests/*.mjs",
    "check": "node features/edithere/editor/build.mjs && node packaging/check.mjs",
    "pack": "node features/edithere/editor/build.mjs && electron-builder --dir --publish never",
    "dist": "node features/edithere/editor/build.mjs && electron-builder --publish never",
    "dist:linux": "node features/edithere/editor/build.mjs && electron-builder --linux deb AppImage --publish never",
    "dist:win": "node features/edithere/editor/build.mjs && electron-builder --win nsis --publish never",
    "dist:mac": "node features/edithere/editor/build.mjs && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "36.9.5",
    "electron-builder": "26.0.12"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "electron-winstaller@5.4.0": true
  }
}
