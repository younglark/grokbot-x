#!/bin/sh
# Ask a running grokbot-x instance to quit. Grok Bot is not touched.
set -eu
if [ -n "${GROKBOT_X_STATE_DIR:-}" ]; then
  DIR=$GROKBOT_X_STATE_DIR
elif [ "$(uname -s)" = Darwin ]; then
  DIR="$HOME/Library/Application Support/grokbot-x"
else
  DIR="${XDG_STATE_HOME:-$HOME/.local/state}/grokbot-x"
fi
mkdir -p "$DIR"
echo "$(date +%s)" > "$DIR/stop.request"
echo "Requested grokbot-x to stop ($DIR/stop.request). Grok Bot was not touched."
